# 数据库连接（PostGIS，手动跑服务时用）
DATABASE_URL=postgresql://postgres:你的密码@localhost:5432/gisjobs
# 高德 Web服务 Key（ETL 地理编码用，lbs.amap.com 申请）
AMAP_KEY=你的高德Key

# ---- Docker Compose（一键启动）----
# Compose 用下面三项拼出容器内的 DATABASE_URL；本地开发默认值可直接用，仅用于本机。
# 如需改密码，改这里即可（手动跑服务时改上面 DATABASE_URL）。
POSTGRES_USER=gisjobs
POSTGRES_PASSWORD=gisjobs
POSTGRES_DB=gisjobs
# 大屏在浏览器里访问瓦片服务的地址（本机默认即可）
VITE_TILE_SERVER=http://localhost:3112
